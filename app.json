{
  "expo": {
    "name": "Demo",
    "slug": "demo-francisco",
    "scheme": "demofrancisco",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B0B0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.demofrancisco",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Zavnir necesita acceso a tus fotos para que puedas publicarlas.",
        "NSCameraUsageDescription": "Zavnir usa la cámara para que hagas fotos y vídeos y los publiques.",
        "NSMicrophoneUsageDescription": "Zavnir usa el micrófono para grabar el sonido de tus vídeos."
      }
    },
    "android": {
      "package": "com.example.demofrancisco",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zavnir necesita acceso a tus fotos para que puedas publicarlas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}